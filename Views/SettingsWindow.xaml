<Window x:Class="PCModeSwitcher.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="アプリ設定" Width="590" Height="700"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="28">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="0,0,10,0">
        <TextBlock Text="アプリ設定" FontSize="24" FontWeight="SemiBold"/>
        <TextBlock Text="起動方法、閉じるボタン、モード切り替えキーを設定します。"
                   Foreground="{StaticResource MutedBrush}" Margin="0,6,0,20"/>

        <TextBlock Text="Windowsログイン時の起動" FontSize="18" FontWeight="SemiBold"
                   Margin="0,0,0,8"/>
        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                Background="White" CornerRadius="10" Padding="18" Margin="0,0,0,22">
          <StackPanel>
            <CheckBox x:Name="StartWithWindowsOption"
                      Content="Windowsにログインしたとき自動的に起動"
                      FontWeight="SemiBold"/>
            <TextBlock Text="現在のユーザーだけに適用されます。ショートカットを常時使う場合に便利です。"
                       Foreground="{StaticResource MutedBrush}" Margin="24,4,0,0"/>
          </StackPanel>
        </Border>

        <TextBlock Text="閉じるボタンの動作" FontSize="18" FontWeight="SemiBold"
                   Margin="0,0,0,8"/>
        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                Background="White" CornerRadius="10" Padding="18" Margin="0,0,0,22">
          <StackPanel>
            <RadioButton x:Name="MinimizeToTrayOption" GroupName="CloseBehavior"
                         Content="通知領域に格納" FontWeight="SemiBold"/>
            <TextBlock Text="アプリは動作を続けます。通知領域アイコンから再表示・終了できます。"
                       Foreground="{StaticResource MutedBrush}" Margin="24,4,0,16"/>
            <RadioButton x:Name="ExitApplicationOption" GroupName="CloseBehavior"
                         Content="アプリを終了" FontWeight="SemiBold"/>
            <TextBlock Text="閉じるボタンでアプリを完全に終了します。ショートカットも停止します。"
                       Foreground="{StaticResource MutedBrush}" Margin="24,4,0,16"/>
            <Separator/>
            <StackPanel Margin="0,14,0,0"
                        IsEnabled="{Binding IsChecked, ElementName=MinimizeToTrayOption}">
              <CheckBox x:Name="ShowTrayNotificationOption"
                        Content="通知領域へ格納したときに通知を表示" FontWeight="SemiBold"/>
              <TextBlock Text="通知はアプリを起動してから最初の1回だけ表示します。"
                         Foreground="{StaticResource MutedBrush}" Margin="24,4,0,0"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <TextBlock Text="モード切り替えショートカット" FontSize="18" FontWeight="SemiBold"
                   Margin="0,0,0,4"/>
        <TextBlock Text="入力欄をクリックして、Ctrl／Alt／Shift／Winのいずれかとキーを同時に押します。アプリが動作中なら、他の画面を操作していても使えます。"
                   Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>
        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                Background="White" CornerRadius="10" Padding="18">
          <StackPanel>
            <Grid Margin="0,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="85"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="GAME" FontWeight="Bold" VerticalAlignment="Center"/>
              <TextBox x:Name="GameHotkeyTextBox" Grid.Column="1" Tag="game"
                       IsReadOnly="True" Padding="10,7" Margin="8,0"
                       PreviewKeyDown="HotkeyTextBox_PreviewKeyDown"/>
              <Button Grid.Column="2" Content="解除" Tag="game" Padding="12,6"
                      Click="ClearHotkey_Click"/>
            </Grid>
            <Grid Margin="0,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="85"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="WORK" FontWeight="Bold" VerticalAlignment="Center"/>
              <TextBox x:Name="WorkHotkeyTextBox" Grid.Column="1" Tag="work"
                       IsReadOnly="True" Padding="10,7" Margin="8,0"
                       PreviewKeyDown="HotkeyTextBox_PreviewKeyDown"/>
              <Button Grid.Column="2" Content="解除" Tag="work" Padding="12,6"
                      Click="ClearHotkey_Click"/>
            </Grid>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="85"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="NORMAL" FontWeight="Bold" VerticalAlignment="Center"/>
              <TextBox x:Name="NormalHotkeyTextBox" Grid.Column="1" Tag="normal"
                       IsReadOnly="True" Padding="10,7" Margin="8,0"
                       PreviewKeyDown="HotkeyTextBox_PreviewKeyDown"/>
              <Button Grid.Column="2" Content="解除" Tag="normal" Padding="12,6"
                      Click="ClearHotkey_Click"/>
            </Grid>
            <TextBlock x:Name="ShortcutValidationMessage" Foreground="#B91C1C"
                       Margin="0,12,0,0" Visibility="Collapsed"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"
                Margin="0,22,0,0">
      <Button Content="キャンセル" IsCancel="True"/>
      <Button Content="保存" Style="{StaticResource PrimaryButtonStyle}" IsDefault="True"
              Click="Save_Click"/>
    </StackPanel>
  </Grid>
</Window>
