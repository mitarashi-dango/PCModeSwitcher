<Window x:Class="PCModeSwitcher.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:PCModeSwitcher.Services"
        Title="{loc:Loc Settings.Title}" Width="640" Height="760"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="28">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="0,0,10,0">
        <TextBlock Text="{loc:Loc Settings.Title}" FontSize="24" FontWeight="SemiBold"/>
        <TextBlock Text="{loc:Loc Settings.Description}"
                   Foreground="{StaticResource MutedBrush}" Margin="0,6,0,20"/>

        <TextBlock Text="{loc:Loc Settings.Language}" FontSize="18" FontWeight="SemiBold"
                   Margin="0,0,0,8"/>
        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                Background="White" CornerRadius="10" Padding="18" Margin="0,0,0,22">
          <StackPanel>
            <ComboBox x:Name="LanguageOption" SelectedValuePath="Tag">
              <ComboBoxItem Tag="system" Content="{loc:Loc Language.System}"/>
              <ComboBoxItem Tag="ja-JP" Content="{loc:Loc Language.Japanese}"/>
              <ComboBoxItem Tag="en-US" Content="{loc:Loc Language.English}"/>
              <ComboBoxItem Tag="zh-Hans" Content="{loc:Loc Language.SimplifiedChinese}"/>
              <ComboBoxItem Tag="zh-Hant" Content="{loc:Loc Language.TraditionalChinese}"/>
              <ComboBoxItem Tag="es-ES" Content="{loc:Loc Language.Spanish}"/>
              <ComboBoxItem Tag="ar-SA" Content="{loc:Loc Language.Arabic}"/>
              <ComboBoxItem Tag="hi-IN" Content="{loc:Loc Language.Hindi}"/>
              <ComboBoxItem Tag="eo" Content="{loc:Loc Language.Esperanto}"/>
            </ComboBox>
            <TextBlock Text="{loc:Loc Settings.LanguageDescription}"
                       Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/>
          </StackPanel>
        </Border>

        <TextBlock Text="{loc:Loc Settings.Updates}" FontSize="18" FontWeight="SemiBold"
                   Margin="0,0,0,8"/>
        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                Background="White" CornerRadius="10" Padding="18" Margin="0,0,0,22">
          <StackPanel>
            <CheckBox x:Name="CheckForUpdatesAutomaticallyOption"
                      Content="{loc:Loc Settings.CheckForUpdatesAutomatically}"
                      FontWeight="SemiBold"/>
            <TextBlock Text="{loc:Loc Settings.UpdateDescription}"
                       Foreground="{StaticResource MutedBrush}" Margin="24,4,0,0"
                       TextWrapping="Wrap"/>
          </StackPanel>
        </Border>

        <TextBlock Text="{loc:Loc Settings.MicrophoneFeature}" FontSize="18" FontWeight="SemiBold"
                   Margin="0,0,0,8"/>
        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                Background="White" CornerRadius="10" Padding="18" Margin="0,0,0,22">
          <StackPanel>
            <CheckBox x:Name="ShowMicrophoneControlsOption"
                      Content="{loc:Loc Settings.EnableMicrophone}"
                      FontWeight="SemiBold"/>
            <TextBlock Text="{loc:Loc Settings.MicrophoneDescription}"
                       Foreground="{StaticResource MutedBrush}" Margin="24,4,0,0"/>
          </StackPanel>
        </Border>

        <TextBlock Text="{loc:Loc Settings.Startup}" FontSize="18" FontWeight="SemiBold"
                   Margin="0,0,0,8"/>
        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                Background="White" CornerRadius="10" Padding="18" Margin="0,0,0,22">
          <StackPanel>
            <CheckBox x:Name="StartWithWindowsOption"
                      Content="{loc:Loc Settings.StartWithWindows}"
                      FontWeight="SemiBold"/>
            <TextBlock Text="{loc:Loc Settings.StartupDescription}"
                       Foreground="{StaticResource MutedBrush}" Margin="24,4,0,0"/>
          </StackPanel>
        </Border>

        <TextBlock Text="{loc:Loc Settings.CloseBehavior}" FontSize="18" FontWeight="SemiBold"
                   Margin="0,0,0,8"/>
        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                Background="White" CornerRadius="10" Padding="18" Margin="0,0,0,22">
          <StackPanel>
            <RadioButton x:Name="MinimizeToTrayOption" GroupName="CloseBehavior"
                         Content="{loc:Loc Settings.MinimizeToTray}" FontWeight="SemiBold"/>
            <TextBlock Text="{loc:Loc Settings.MinimizeDescription}"
                       Foreground="{StaticResource MutedBrush}" Margin="24,4,0,16"/>
            <RadioButton x:Name="ExitApplicationOption" GroupName="CloseBehavior"
                         Content="{loc:Loc Settings.ExitApplication}" FontWeight="SemiBold"/>
            <TextBlock Text="{loc:Loc Settings.ExitDescription}"
                       Foreground="{StaticResource MutedBrush}" Margin="24,4,0,16"/>
            <Separator/>
            <StackPanel Margin="0,14,0,0"
                        IsEnabled="{Binding IsChecked, ElementName=MinimizeToTrayOption}">
              <CheckBox x:Name="ShowTrayNotificationOption"
                        Content="{loc:Loc Settings.ShowTrayNotification}" FontWeight="SemiBold"/>
              <TextBlock Text="{loc:Loc Settings.TrayNotificationDescription}"
                         Foreground="{StaticResource MutedBrush}" Margin="24,4,0,0"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <TextBlock Text="{loc:Loc Settings.VisibleModes}" FontSize="18" FontWeight="SemiBold"
                   Margin="0,0,0,4"/>
        <TextBlock Text="{loc:Loc Settings.VisibleModesDescription}"
                   Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>
        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                Background="White" CornerRadius="10" Padding="18" Margin="0,0,0,22">
          <StackPanel>
            <ItemsControl ItemsSource="{Binding ModeItems, RelativeSource={RelativeSource AncestorType=Window}}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="3"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,5,8,5">
                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsModeEnabled, Mode=TwoWay}"
                              FontWeight="SemiBold"/>
                    <CheckBox Content="{loc:Loc Settings.ShowOnMain}" IsChecked="{Binding IsVisible, Mode=TwoWay}"
                              IsEnabled="{Binding IsModeEnabled}" Margin="18,3,0,0"
                              Checked="VisibleModeCheckBox_Changed"
                              Unchecked="VisibleModeCheckBox_Changed"/>
                    <Button Content="{loc:Loc Settings.DeletePermanently}" Tag="{Binding Id}" Click="DeleteMode_Click"
                            Visibility="{Binding CanDelete, Converter={StaticResource BoolToVisibility}}"
                            Foreground="#B91C1C" HorizontalAlignment="Left"
                            Margin="18,4,0,0" Padding="8,3"
                            ToolTip="{loc:Loc Settings.DeleteTip}"/>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="ModeSelectionValidationMessage" Foreground="#B91C1C"
                       Margin="0,10,0,0" Visibility="Collapsed"/>
          </StackPanel>
        </Border>

        <TextBlock Text="{loc:Loc Settings.Shortcuts}" FontSize="18" FontWeight="SemiBold"
                   Margin="0,0,0,4"/>
        <TextBlock Text="{loc:Loc Settings.ShortcutsDescription}"
                   Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>
        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                Background="White" CornerRadius="10" Padding="18">
          <StackPanel>
            <ItemsControl ItemsSource="{Binding ModeItems, RelativeSource={RelativeSource AncestorType=Window}}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="105"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <Grid Width="28" Height="22" VerticalAlignment="Center">
                        <Image Source="{Binding CustomIconSource}" Stretch="Uniform"
                               Visibility="{Binding HasCustomIcon, Converter={StaticResource BoolToVisibility}}"/>
                        <TextBlock Text="{Binding Icon}" FontFamily="Segoe UI Emoji"
                                   FontSize="18" HorizontalAlignment="Left" VerticalAlignment="Center">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding HasCustomIcon}" Value="True">
                                  <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </Grid>
                      <TextBlock Text="{Binding Name}" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBox Grid.Column="1" Tag="{Binding Id}" Text="{Binding HotkeyText}"
                             IsReadOnly="True" Padding="10,7" Margin="8,0"
                             PreviewKeyDown="HotkeyTextBox_PreviewKeyDown"/>
                    <Button Grid.Column="2" Content="{loc:Loc Common.Clear}" Tag="{Binding Id}" Padding="12,6"
                            Click="ClearHotkey_Click"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Separator Margin="0,4,0,12"/>
            <Grid Margin="0,0,0,10">
              <Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="{loc:Loc Common.Restore}" FontWeight="Bold" VerticalAlignment="Center"/>
              <TextBox x:Name="RestoreHotkeyText" Grid.Column="1" Tag="restore" IsReadOnly="True" Padding="10,7" Margin="8,0" PreviewKeyDown="HotkeyTextBox_PreviewKeyDown"/>
              <Button Grid.Column="2" Content="{loc:Loc Common.Clear}" Tag="restore" Padding="12,6" Click="ClearHotkey_Click"/>
            </Grid>
            <TextBlock x:Name="ShortcutValidationMessage" Foreground="#B91C1C"
                       Margin="0,12,0,0" Visibility="Collapsed"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"
                Margin="0,22,0,0">
      <Button Content="{loc:Loc Common.Cancel}" IsCancel="True"/>
      <Button Content="{loc:Loc Common.Save}" Style="{StaticResource PrimaryButtonStyle}" IsDefault="True"
              Click="Save_Click"/>
    </StackPanel>
  </Grid>
</Window>
