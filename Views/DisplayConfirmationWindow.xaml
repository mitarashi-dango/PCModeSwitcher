<Window x:Class="PCModeSwitcher.Views.DisplayConfirmationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:PCModeSwitcher.Services"
        Title="{loc:Loc DisplayConfirmation.Title}" Width="460" Height="230" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <StackPanel Margin="28"><TextBlock Text="{loc:Loc DisplayConfirmation.Heading}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding Message}" Margin="0,12" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><Button Content="{loc:Loc Common.Restore}" Click="Revert_Click"/><Button Content="{loc:Loc DisplayConfirmation.Use}" Style="{StaticResource PrimaryButtonStyle}" Click="Accept_Click" IsDefault="True"/></StackPanel></StackPanel>
</Window>
