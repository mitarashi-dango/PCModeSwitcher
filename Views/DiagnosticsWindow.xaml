<Window x:Class="PCModeSwitcher.Views.DiagnosticsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:PCModeSwitcher.Services"
        Title="{loc:Loc Diagnostics.Title}" Width="820" Height="650" MinWidth="650" MinHeight="480" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBox x:Name="ReportText" FontFamily="Consolas" FontSize="13" IsReadOnly="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
    <WrapPanel Grid.Row="1" Margin="0,14,0,0"><Button Content="{loc:Loc Diagnostics.Copy}" Click="Copy_Click"/><Button Content="{loc:Loc Diagnostics.OpenLogs}" Click="Logs_Click"/><Button Content="{loc:Loc Diagnostics.OpenSettings}" Click="Settings_Click"/><Button Content="{loc:Loc Diagnostics.SaveReport}" Click="Save_Click"/><Button Content="{loc:Loc Diagnostics.BackupAll}" Click="Backup_Click"/></WrapPanel>
  </Grid>
</Window>
