<Window x:Class="PCModeSwitcher.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:PCModeSwitcher.Services"
        Title="{loc:Loc About.Title}"
        Width="520" Height="330"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Border Background="#172033" Padding="28,22">
      <StackPanel Orientation="Horizontal">
        <Image Source="/Assets/AppIcon.png" Width="68" Height="68" Stretch="Uniform"
               RenderOptions.BitmapScalingMode="HighQuality"/>
        <StackPanel Margin="20,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="PC Mode Switcher"
                     Foreground="White" FontSize="25" FontWeight="SemiBold"/>
          <TextBlock x:Name="VersionText"
                     Foreground="#CBD5E1" FontSize="13" Margin="0,5,0,0"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <Grid Grid.Row="1" Margin="28,24,28,20">
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <StackPanel>
        <TextBlock FontSize="15" LineHeight="23"
                   Text="{loc:Loc About.Description}"/>
        <TextBlock Margin="0,18,0,0" Foreground="{StaticResource MutedBrush}">
          <Hyperlink Click="ProjectLink_Click"><Run Text="{loc:Loc About.ProjectLink}"/></Hyperlink>
        </TextBlock>
        <TextBlock Text="© 2026 mitarashi-dango"
                   Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,14,0,0"/>
      </StackPanel>

      <Button Grid.Row="1" Content="{loc:Loc Common.Close}" Width="96"
              HorizontalAlignment="Right" IsDefault="True" IsCancel="True"/>
    </Grid>
  </Grid>
</Window>
