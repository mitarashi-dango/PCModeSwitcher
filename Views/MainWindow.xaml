<Window x:Class="PCModeSwitcher.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:PCModeSwitcher.Services"
        Title="PC Mode Switcher" Width="1180" Height="720"
        MinWidth="980" MinHeight="480"
        WindowStartupLocation="CenterScreen">
  <Grid IsEnabled="{Binding IsInteractionEnabled}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Menu Background="White" Padding="8,2">
      <MenuItem Header="{loc:Loc Main.Menu.Mode}">
        <MenuItem Header="{loc:Loc Main.Menu.RestorePreModeState}" Command="{Binding RestoreModeCommand}"/>
        <Separator/>
        <MenuItem Header="{loc:Loc Main.Menu.New}" Click="NewMode_Click"/>
        <Separator/>
        <MenuItem Header="{loc:Loc Main.Menu.Import}" Click="ImportModes_Click"/>
        <MenuItem Header="{loc:Loc Main.Menu.Export}" Click="ExportModes_Click"/>
      </MenuItem>
      <MenuItem Header="{loc:Loc Main.Menu.Settings}">
        <MenuItem Header="{loc:Loc Main.Menu.AppSettings}" Click="Settings_Click"/>
        <MenuItem Header="{loc:Loc Main.Menu.Diagnostics}" Click="Diagnostics_Click"/>
      </MenuItem>
      <MenuItem Header="{loc:Loc Main.Menu.Help}">
        <MenuItem Header="{loc:Loc Update.CheckMenu}" Click="CheckForUpdates_Click"/>
        <Separator/>
        <MenuItem Header="{loc:Loc Main.Menu.Support}" Click="Support_Click"/>
        <Separator/>
        <MenuItem Header="{loc:Loc Main.Menu.About}" Click="About_Click"/>
      </MenuItem>
    </Menu>

    <Border Grid.Row="1" Background="#172033" Padding="32,24">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="PC Mode Switcher" Foreground="White" FontSize="28" FontWeight="SemiBold"/>
          <TextBlock Text="{loc:Loc Main.Tagline}"
                     Foreground="#CBD5E1" Margin="0,4,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Content="{loc:Loc Main.RestorePrompt}"
                  Command="{Binding RestoreModeCommand}"
                  Visibility="{Binding IsRestorePromptVisible, Converter={StaticResource BoolToVisibility}}"
                  MinWidth="112" Margin="0,0,12,0" Padding="18,8">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="#94A3B8"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontWeight" Value="Normal"/>
                <Setter Property="Opacity" Value="0.82"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsRestoreEmphasized}" Value="True">
                    <Setter Property="Background" Value="#334155"/>
                    <Setter Property="Foreground" Value="#E2E8F0"/>
                    <Setter Property="BorderBrush" Value="#64748B"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Opacity" Value="1"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>
          <Button Content="{Binding MicrophoneButtonText}"
                  Command="{Binding ToggleMicrophoneCommand}"
                  ToolTip="{Binding MicrophoneButtonToolTip}"
                  AutomationProperties.Name="{Binding MicrophoneButtonText}"
                  Visibility="{Binding ShowMicrophoneControls, Converter={StaticResource BoolToVisibility}}"
                  MinWidth="112" Margin="0,0,12,0" Padding="18,8"
                  Foreground="White" FontWeight="SemiBold" BorderThickness="0">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="#475569"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsMicrophoneOn}" Value="True">
                    <Setter Property="Background" Value="#15803D"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding IsMicrophoneOn}" Value="False">
                    <Setter Property="Background" Value="#B91C1C"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>
          <Border Background="#243047" CornerRadius="12" Padding="18,10">
            <StackPanel Orientation="Horizontal">
              <Grid Width="58" Height="30" VerticalAlignment="Center">
                <Image Source="{Binding CurrentModeCustomIconSource}" Stretch="Uniform">
                  <Image.Style>
                    <Style TargetType="Image">
                      <Setter Property="Visibility" Value="Collapsed"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentModeId}" Value="game">
                          <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Image.Style>
                </Image>
                <Rectangle Fill="White">
                  <Rectangle.OpacityMask>
                    <ImageBrush ImageSource="{Binding CurrentModeCustomIconSource}" Stretch="Uniform"/>
                  </Rectangle.OpacityMask>
                  <Rectangle.Style>
                    <Style TargetType="Rectangle">
                      <Setter Property="Visibility" Value="Collapsed"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentModeHasCustomIcon}" Value="True">
                          <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding CurrentModeId}" Value="game">
                          <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Rectangle.Style>
                </Rectangle>
                <TextBlock Text="{Binding CurrentModeIcon}" FontFamily="Segoe UI Emoji"
                           Foreground="White" FontSize="26"
                           HorizontalAlignment="Center" VerticalAlignment="Center">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentModeHasCustomIcon}" Value="True">
                          <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </Grid>
              <StackPanel Margin="12,0,0,0">
                <TextBlock Text="{loc:Loc Main.CurrentMode}" Foreground="#94A3B8" FontSize="12"/>
                <TextBlock Text="{Binding CurrentModeName}" Foreground="White" FontSize="19" FontWeight="SemiBold"/>
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#CBD5E1"
            BorderThickness="0,0,0,1" Padding="28,9"
            Visibility="{Binding HasAvailableUpdate, Converter={StaticResource BoolToVisibility}}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding UpdateBannerText}" Foreground="#334155"
                   VerticalAlignment="Center" TextWrapping="Wrap"/>
        <Button Grid.Column="1" Content="{loc:Loc Update.ViewRelease}"
                Click="ViewUpdate_Click" Margin="16,0,4,0" Padding="10,4"
                Background="Transparent" BorderThickness="0" Foreground="#2563EB"/>
        <Button Grid.Column="2" Content="×" Click="DismissUpdate_Click"
                ToolTip="{loc:Loc Update.Dismiss}" AutomationProperties.Name="{loc:Loc Update.Dismiss}"
                Width="30" Padding="4" Background="Transparent" BorderThickness="0"
                Foreground="#64748B" FontSize="16"/>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" CanContentScroll="False"
                  HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
      <ItemsControl x:Name="ModeCards" ItemsSource="{Binding VisibleModes}"
                    Margin="28,28,14,28" VerticalAlignment="Top"
                    AllowDrop="True" DragOver="ModeCards_DragOver" Drop="ModeCards_Drop">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Rows="1"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border x:Name="ModeCardRoot" Style="{StaticResource CardStyle}" MinHeight="570">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Background="Transparent" Cursor="SizeAll" Padding="6,2" Margin="0,0,0,8"
                        Tag="{Binding Mode.Id}"
                        PreviewMouseLeftButtonDown="ModeDragHandle_PreviewMouseLeftButtonDown"
                        PreviewMouseMove="ModeDragHandle_PreviewMouseMove"
                        GiveFeedback="ModeDragHandle_GiveFeedback"
                        ToolTip="{loc:Loc Main.DragTip}">
                  <TextBlock Text="{loc:Loc Main.Drag}" Foreground="{StaticResource MutedBrush}"
                             FontSize="12" HorizontalAlignment="Center"/>
                </Border>
                <Grid Grid.Row="1" Width="96" Height="48" HorizontalAlignment="Center">
                  <Image Source="{Binding CustomIconSource}" Stretch="Uniform"
                         Visibility="{Binding HasCustomIcon, Converter={StaticResource BoolToVisibility}}"/>
                  <TextBlock Text="{Binding Icon}" FontFamily="Segoe UI Emoji" FontSize="44"
                             Foreground="{StaticResource TextBrush}"
                             HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding HasCustomIcon}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </Grid>
                <TextBlock Grid.Row="2" Text="{Binding Name}" FontSize="25" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,8,0,22"/>
                <StackPanel Grid.Row="3">
                  <TextBlock Text="{loc:Loc Main.DisplayOff}" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                  <TextBlock Text="{Binding DisplaySummary}" Margin="0,2,0,14"/>
                  <TextBlock Text="{loc:Loc Main.Sleep}" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                  <TextBlock Text="{Binding SleepSummary}" Margin="0,2,0,14"/>
                  <TextBlock Text="{loc:Loc Main.PowerMode}" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                  <TextBlock Text="{Binding PowerPlanName}" Margin="0,2,0,14"/>
                  <StackPanel Visibility="{Binding ShowMicrophoneControls, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{loc:Loc Main.Microphone}" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                    <TextBlock Text="{Binding MicrophoneSummary}" Margin="0,2,0,14"/>
                  </StackPanel>
                </StackPanel>
                <StackPanel Grid.Row="4">
                  <Button Content="{loc:Loc Common.Apply}" Style="{StaticResource PrimaryButtonStyle}"
                          Command="{Binding DataContext.ApplyModeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                          CommandParameter="{Binding}"/>
                  <Button Content="{loc:Loc Common.Edit}"
                          Command="{Binding DataContext.EditModeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                          CommandParameter="{Binding}"/>
                  <Button Content="{loc:Loc Main.Review}" Tag="{Binding}" Click="DryRun_Click"/>
                  <UniformGrid Columns="2" Margin="0,6,0,0">
                    <Button Content="{loc:Loc Common.Duplicate}" Tag="{Binding Mode.Id}" Click="DuplicateMode_Click" Padding="4"/>
                    <Button Content="{loc:Loc Common.Hide}" Tag="{Binding Mode.Id}" Click="HideMode_Click" Padding="4"
                            ToolTip="{loc:Loc Main.HideTip}"/>
                  </UniformGrid>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <Border Grid.Row="4" Background="White" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,1,0,0" Padding="28,16">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding StatusMessage}" FontSize="14" VerticalAlignment="Center"
                   TextWrapping="Wrap"/>
        <TextBlock Grid.Column="1" Text="{Binding AppVersion}" FontSize="12"
                   Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="24,0,0,0"/>
      </Grid>
    </Border>

    <Canvas x:Name="DragPreviewLayer" Grid.RowSpan="5" Panel.ZIndex="1000"
            IsHitTestVisible="False" ClipToBounds="True"/>
  </Grid>
</Window>
