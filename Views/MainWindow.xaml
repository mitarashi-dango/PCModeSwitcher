<Window x:Class="PCModeSwitcher.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PC Mode Switcher" Width="1060" Height="720"
        MinWidth="860" MinHeight="600"
        WindowStartupLocation="CenterScreen">
  <Grid IsEnabled="{Binding IsInteractionEnabled}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Menu Background="White" Padding="8,2">
      <MenuItem Header="設定">
        <MenuItem Header="アプリ設定..." Click="Settings_Click"/>
      </MenuItem>
    </Menu>

    <Border Grid.Row="1" Background="#172033" Padding="32,24">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="PC Mode Switcher" Foreground="White" FontSize="28" FontWeight="SemiBold"/>
          <TextBlock Text="使い方に合わせて、PCの電源設定を1クリックで切り替えます。"
                     Foreground="#CBD5E1" Margin="0,4,0,0"/>
        </StackPanel>
        <Border Grid.Column="1" Background="#243047" CornerRadius="12" Padding="18,10">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding CurrentModeIcon}" FontFamily="Segoe UI Emoji" FontSize="26" VerticalAlignment="Center"/>
            <StackPanel Margin="12,0,0,0">
              <TextBlock Text="現在のモード" Foreground="#94A3B8" FontSize="12"/>
              <TextBlock Text="{Binding CurrentModeName}" Foreground="White" FontSize="19" FontWeight="SemiBold"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="28">
      <ItemsControl ItemsSource="{Binding Modes}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="3"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource CardStyle}" MinHeight="390">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding Icon}" FontFamily="Segoe UI Emoji" FontSize="44" HorizontalAlignment="Center"/>
                <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="25" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,8,0,22"/>
                <StackPanel Grid.Row="2">
                  <TextBlock Text="画面OFF" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                  <TextBlock Text="{Binding DisplaySummary}" Margin="0,2,0,14"/>
                  <TextBlock Text="スリープ" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                  <TextBlock Text="{Binding SleepSummary}" Margin="0,2,0,14"/>
                  <TextBlock Text="電源モード" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                  <TextBlock Text="{Binding PowerPlanName}" Margin="0,2,0,14"/>
                </StackPanel>
                <StackPanel Grid.Row="3">
                  <Button Content="適用" Style="{StaticResource PrimaryButtonStyle}"
                          Command="{Binding DataContext.ApplyModeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                          CommandParameter="{Binding}"/>
                  <Button Content="編集"
                          Command="{Binding DataContext.EditModeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                          CommandParameter="{Binding}"/>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,1,0,0" Padding="28,16">
      <TextBlock Text="{Binding StatusMessage}" FontSize="14"/>
    </Border>
  </Grid>
</Window>
