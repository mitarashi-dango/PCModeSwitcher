<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <AssemblyName>PCModeSwitcher</AssemblyName>
    <RootNamespace>PCModeSwitcher</RootNamespace>
    <Product>PC Mode Switcher</Product>
    <Description>Windows 11の電源設定をGAME / WORK / NORMALの3モードで切り替えるアプリ</Description>
    <Authors>mitarashi-dango</Authors>
    <RepositoryUrl>https://github.com/mitarashi-dango/PCModeSwitcher</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <NeutralLanguage>ja-JP</NeutralLanguage>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Compile Remove="tests\**\*.cs" />
    <Page Remove="tests\**\*.xaml" />
    <Resource Include="Assets\AppIcon.ico" />
  </ItemGroup>
</Project>
